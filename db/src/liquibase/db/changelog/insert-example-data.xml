<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">
    
    <changeSet id="5" author="eric">
        <comment>Insert initial user, account, and category</comment>

        <!-- Insert user -->
        <insert tableName="users">
            <column name="id" value="11111111-1111-1111-1111-111111111111"/>
            <column name="username" value="testuser"/>
            <column name="email" value="test@example.com"/>
            <column name="password_hash" value="hashedpassword123"/>
        </insert>

        <!-- Insert account -->
        <insert tableName="account">
            <column name="id" value="22222222-2222-2222-2222-222222222222"/>
            <column name="user_id" value="11111111-1111-1111-1111-111111111111"/>
            <column name="name" value="Cash"/>
            <column name="balance" valueNumeric="1000.00"/>
        </insert>

        <!-- Insert category -->
        <insert tableName="category">
            <column name="id" value="33333333-3333-3333-3333-333333333333"/>
            <column name="name" value="Food"/>
            <column name="type" value="EXPENSE"/>
        </insert>
    </changeSet>

    <!-- Insert transcations-->
    <changeSet id="6" author="eric">
        <comment>Insert sample transactions for test user</comment>

        <!-- Transaction 1 -->
        <insert tableName="transaction">
            <column name="id" value="44444444-4444-4444-4444-444444444444"/>
            <column name="account_id" value="22222222-2222-2222-2222-222222222222"/>
            <column name="category_id" value="33333333-3333-3333-3333-333333333333"/>
            <column name="amount" valueNumeric="15.75"/>
            <column name="date" valueDate="2024-05-01T12:00:00"/>
            <column name="note" value="Lunch at cafe"/>
        </insert>

        <!-- Transaction 2 -->
        <insert tableName="transaction">
            <column name="id" value="55555555-5555-5555-5555-555555555555"/>
            <column name="account_id" value="22222222-2222-2222-2222-222222222222"/>
            <column name="category_id" value="33333333-3333-3333-3333-333333333333"/>
            <column name="amount" valueNumeric="40.00"/>
            <column name="date" valueDate="2024-05-02T18:45:00"/>
            <column name="note" value="Dinner with friends"/>
        </insert>

        <!-- Transaction 3 -->
        <insert tableName="transaction">
            <column name="id" value="66666666-6666-6666-6666-666666666666"/>
            <column name="account_id" value="22222222-2222-2222-2222-222222222222"/>
            <column name="category_id" value="33333333-3333-3333-3333-333333333333"/>
            <column name="amount" valueNumeric="100"/>
            <column name="date" valueDate="2024-05-03T09:30:00"/>
            <column name="note" value="Coffee and bagel"/>
        </insert>
    </changeSet>

</databaseChangeLog>
